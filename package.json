{
  "name": "samp-boombox-tool",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run build:css -- --watch\" \"vercel dev\"",
    "dev:tsx": "concurrently \"npm run build:css -- --watch\" \"tsx watch src/server.ts\"",
    "build:css": "tailwindcss -i ./src/views/styles.css -o ./public/css/style.css --minify",
    "build": "npm run build:css && tsc && cp -r src/views dist/views",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "axios": "^1.7.0",
    "express": "^4.22.2",
    "form-data": "^4.0.6",
    "multer": "^1.4.5-lts.2",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
