extends layout.pug

block content
  div(class="space-y-8")
    div(class="space-y-2")
      h1(class="text-3xl font-bold tracking-tight" data-i18n="home_title") Developer Utilities & Tools
      p(class="text-neutral-500 dark:text-neutral-400 text-sm sm:text-base" data-i18n="home_desc") A minimal, high-performance suite of automation tools built for modern web workflows.

    div(class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4")
      a(href="/boombox" class="group p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-all bg-white dark:bg-[#0a0a0a] flex flex-col justify-between shadow-xs")
        div(class="space-y-3")
          div(class="w-10 h-10 rounded-lg border border-neutral-200 dark:border-neutral-800 flex items-center justify-center text-neutral-900 dark:text-neutral-100 group-hover:scale-105 transition-transform")
            // Audio / Radio Icon
            svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5")
              path(stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z")
          h2(class="font-semibold text-base") Boombox Converter
          p(class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed") Convert YouTube audio or local files directly into direct streaming links for GTA SA-MP Top4Top hosting.
        div(class="mt-6 flex items-center text-xs font-semibold text-neutral-900 dark:text-neutral-100 gap-1.5 group-hover:translate-x-1 transition-transform")
          span Launch Tool
          svg(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
            path(stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75")
