extends layout.pug

block content
  div(class="max-w-3xl mx-auto space-y-6 animate-fade-in")
    
    // Back Button
    a(href="/" class="inline-flex items-center gap-2 text-sm font-medium text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors group w-fit")
      svg(class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
        path(stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18")
      span(data-i18n="back_to_home") Back to Dashboard

    // Page Header
    div(class="flex flex-col sm:flex-row sm:items-center gap-4 pt-2 pb-4")
      div(class="w-12 h-12 rounded-xl bg-neutral-100 dark:bg-neutral-900/80 border border-neutral-200 dark:border-neutral-800 flex items-center justify-center shrink-0")
        svg(class="w-6 h-6 text-neutral-700 dark:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5")
          path(stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z")
      div(class="space-y-1")
        h1(class="text-2xl font-bold tracking-tight" data-i18n="boombox_heading") Boombox URL Converter
        p(class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-xl" data-i18n="boombox_sub") Convert YouTube videos or local audio files into direct links for GTA SA-MP Top4Top hosting.

    // Main App Container
    div(class="border border-neutral-200 dark:border-neutral-800 rounded-2xl p-2 bg-white dark:bg-[#0a0a0a] shadow-sm")
      div(class="p-4 sm:p-6 space-y-8")
        
        // Segmented Tabs (Vercel Style)
        div(class="p-1 bg-neutral-100 dark:bg-neutral-900 rounded-lg flex items-center gap-1 text-sm font-medium")
          button#btnTabYt(class="flex-1 py-2.5 rounded-md bg-white dark:bg-neutral-800 shadow-sm text-neutral-900 dark:text-white transition-all" onclick="switchMode('yt')")
            div(class="flex items-center justify-center gap-2")
              svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                path(stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244")
              span(data-i18n="tab_yt") YouTube URLs
          
          button#btnTabFile(class="flex-1 py-2.5 rounded-md text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-all" onclick="switchMode('file')")
            div(class="flex items-center justify-center gap-2")
              svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                path(stroke-linecap="round" stroke-linejoin="round" d="M9 8.25H7.5a2.25 2.25 0 00-2.25 2.25v9a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25H15m0-3l-3-3m0 0l-3 3m3-3V15")
              span(data-i18n="tab_file") Local Files

        // Form Area: YouTube
        div#tabYt(class="space-y-4")
          div(class="flex items-center justify-between")
            label(class="block text-xs font-bold text-neutral-600 dark:text-neutral-400 uppercase tracking-wider" data-i18n="yt_label") Enter YouTube URLs
            span(class="text-xs text-neutral-400 font-mono") 1 - 10 links
          textarea#ytUrls(class="w-full h-40 p-4 bg-neutral-50 dark:bg-[#111] border border-neutral-200 dark:border-neutral-800 rounded-xl text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-500 focus:ring-1 focus:ring-neutral-400 dark:focus:ring-neutral-500 resize-none font-mono transition-all leading-relaxed" placeholder="https://www.youtube.com/watch?v=...\nhttps://youtu.be/...")
          button#btnProcessYt(class="w-full py-3 bg-neutral-900 hover:bg-neutral-800 dark:bg-white dark:hover:bg-neutral-200 dark:text-neutral-900 text-white font-semibold rounded-xl text-sm transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" onclick="processYoutube()") 
            span(data-i18n="btn_process_yt") Process & Upload
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
              path(stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75")

        // Form Area: Local File (Modern Dropzone UI)
        div#tabFile(class="space-y-4 hidden")
          label(class="block text-xs font-bold text-neutral-600 dark:text-neutral-400 uppercase tracking-wider" data-i18n="file_label") Select Audio Files
          div(class="relative border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-xl p-8 text-center bg-neutral-50/50 dark:bg-[#111]/50 hover:bg-neutral-50 dark:hover:bg-[#111] transition-colors group")
            div(class="flex flex-col items-center gap-3")
              div(class="w-10 h-10 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 dark:text-neutral-400 group-hover:scale-110 transition-transform")
                svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
                  path(stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z")
              div
                p(class="text-sm font-medium text-neutral-900 dark:text-neutral-100" data-i18n="drag_drop") Click to upload or drag and drop
                p(class="text-xs text-neutral-500 mt-1" data-i18n="file_limit") MP3, WAV, M4A (Max 10 files, 15MB each)
            input#fileInput(type="file" multiple accept="audio/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer")
          
          // Custom File List Display (Optional, can be updated via JS)
          div#fileSelectedList(class="text-xs text-neutral-500 font-mono hidden px-1")
          
          button#btnProcessFile(class="w-full py-3 bg-neutral-900 hover:bg-neutral-800 dark:bg-white dark:hover:bg-neutral-200 dark:text-neutral-900 text-white font-semibold rounded-xl text-sm transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" onclick="processFiles()") 
            span(data-i18n="btn_process_file") Upload to Top4Top
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2")
              path(stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z")

      // Loading State (Vercel Style Pulse)
      div#loading(class="hidden border-t border-neutral-200 dark:border-neutral-800 p-6 flex flex-col items-center justify-center gap-4 bg-neutral-50 dark:bg-neutral-900/20 rounded-b-xl")
        div(class="flex gap-1.5")
          div(class="w-2 h-2 bg-neutral-900 dark:bg-white rounded-full animate-bounce" style="animation-delay: -0.3s")
          div(class="w-2 h-2 bg-neutral-900 dark:bg-white rounded-full animate-bounce" style="animation-delay: -0.15s")
          div(class="w-2 h-2 bg-neutral-900 dark:bg-white rounded-full animate-bounce")
        p#statusText(class="text-xs font-semibold text-neutral-600 dark:text-neutral-400 font-mono tracking-tight" data-i18n="loading_text") Processing audio and uploading...

      // Result Table
      div#resultBox(class="hidden border-t border-neutral-200 dark:border-neutral-800 p-6 space-y-4")
        div(class="flex items-center justify-between")
          h2(class="text-sm font-bold tracking-tight text-neutral-900 dark:text-white" data-i18n="result_title") Generated Links
          span(class="text-xs px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-md font-medium") Success
        
        div(class="overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-800 shadow-sm")
          table(class="w-full text-left border-collapse text-xs")
            thead(class="bg-neutral-50 dark:bg-[#111] text-neutral-500 border-b border-neutral-200 dark:border-neutral-800")
              tr
                th(class="p-3.5 font-semibold" data-i18n="table_source") Source Name
                th(class="p-3.5 font-semibold" data-i18n="table_link") Top4Top Link
                th(class="p-3.5 font-semibold text-center w-24" data-i18n="table_action") Action
            tbody#resultBody(class="divide-y divide-neutral-200 dark:divide-neutral-800 bg-white dark:bg-[#0a0a0a]")

block scripts
  script.
    // Script khusus untuk mengontrol UI pergantian Tab Kapsul
    function switchMode(type) {
      const btnYt = document.getElementById('btnTabYt');
      const btnFile = document.getElementById('btnTabFile');
      const tabYt = document.getElementById('tabYt');
      const tabFile = document.getElementById('tabFile');

      // Base classes
      const activeClass = "flex-1 py-2.5 rounded-md bg-white dark:bg-neutral-800 shadow-sm text-neutral-900 dark:text-white transition-all".split(" ");
      const inactiveClass = "flex-1 py-2.5 rounded-md text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-all".split(" ");

      if (type === 'yt') {
        btnYt.className = activeClass.join(" ");
        btnFile.className = inactiveClass.join(" ");
        tabYt.classList.remove('hidden');
        tabFile.classList.add('hidden');
      } else {
        btnFile.className = activeClass.join(" ");
        btnYt.className = inactiveClass.join(" ");
        tabFile.classList.remove('hidden');
        tabYt.classList.add('hidden');
      }
    }

    // Tampilkan nama file yang dipilih (Opsional agar UX lebih bagus)
    const fileInput = document.getElementById('fileInput');
    const fileList = document.getElementById('fileSelectedList');
    
    if(fileInput && fileList) {
      fileInput.addEventListener('change', (e) => {
        const files = e.target.files;
        if(files.length > 0) {
          fileList.classList.remove('hidden');
          fileList.innerHTML = `<span class="text-neutral-900 dark:text-white font-semibold">${files.length}</span> file(s) selected`;
        } else {
          fileList.classList.add('hidden');
        }
      });
    }

  script(src="/js/main.js")
